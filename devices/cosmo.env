# Planet Cosmo Communicator (kernel: cosmo-linux618). Sourced at the end of
# config.env when DEVICE=cosmo; overrides the Gemini values there.
DEVICE_LOADED=cosmo

# Kernel release built by cosmo-linux618 bin/build-kernel.sh (modules in its
# out/modroot). Must match the kernel in the flashed `boot` image.
EXPECT_KVER=6.18.58-cosmo
COSMO_KERNEL_DIR=../cosmo-linux618

GEMINI_HOSTNAME=cosmo
# USB link to Dragon: the Cosmo serves DHCP on usb0 (NetworkManager shared
# mode), as its initramfs does.
USB_ADDR=10.15.19.83/24

# Plain login account, no Calamares. Desktop: Plasma (Wayland) on panfrost
# with the Gemini desktop list, greetd + tuigreet login on tty1
# (packages/cosmo-desktop.list, overlay-cosmo/etc/greetd).
GEMINI_FIRST_SETUP=0
PACKAGE_LISTS="base.list cosmo-base.list"
EXTRA_LISTS="cosmo-desktop.list"
DESKTOP_LISTS="desktop.list"

IMAGE_SIZE=3G
IMAGE_NAME=cosmo-debian-rootfs.img
IMAGE_LABEL=cosmo-debian

# SSH keys allowed to log in (missing files are skipped). The Cosmo is
# reached from the flashing host as well as from the build host.
AUTHORIZED_KEYS="$HOME/.ssh/id_ed25519.pub $HOME/.ssh/dragon_id_ed25519.pub"
