# Planet Cosmo Communicator (kernel: cosmo-linux618). Sourced at the end of
# config.env when DEVICE=cosmo; overrides the Gemini values there.
DEVICE_LOADED=cosmo

# Kernel release built by cosmo-linux618 bin/build-kernel.sh (modules in its
# out/modroot). Must match the kernel in the flashed `boot` image.
EXPECT_KVER=6.18.58-cosmo
COSMO_KERNEL_DIR=../cosmo-linux618

GEMINI_HOSTNAME=cosmo
# USB link to Dragon: the Cosmo serves DHCP on usb0 (NetworkManager shared
# mode), as its initramfs does.
USB_ADDR=10.15.19.83/24

# Desktop: Plasma (Wayland) on panfrost, SDDM login (Wayland, Breeze;
# overlay-cosmo/etc/sddm.conf.d), Gemini wallpapers. Apps: packages/cosmo-plasma.list (with
# Recommends) and cosmo-apps.list (LibreOffice, fonts, tools; without).
PACKAGE_LISTS="base.list cosmo-base.list"
EXTRA_LISTS="cosmo-desktop.list cosmo-apps.list"
DESKTOP_LISTS="cosmo-plasma.list"

# Release image (COSMO_RELEASE=1 bin/build-rootfs.sh): first-boot setup
# with Calamares, as on the Gemini. The build-time account is a throwaway
# "setup" account with a locked password; Calamares creates the owner's
# account and deletes it. No SSH keys are installed.
# Development image (default): plain login account, no Calamares, SSH keys
# from the build and flashing hosts.
COSMO_RELEASE=${COSMO_RELEASE:-0}
if [ "$COSMO_RELEASE" = 1 ]; then
    GEMINI_FIRST_SETUP=1
    GEMINI_USER=setup
    GEMINI_PASSWORD_HASH='!'
    EXTRA_LISTS="$EXTRA_LISTS cosmo-firstboot.list"
else
    GEMINI_FIRST_SETUP=0
fi

IMAGE_SIZE=8G
IMAGE_NAME=cosmo-debian-rootfs.img
IMAGE_LABEL=cosmo-debian

# SSH keys allowed to log in (missing files are skipped). The Cosmo is
# reached from the flashing host as well as from the build host.
AUTHORIZED_KEYS="$HOME/.ssh/id_ed25519.pub $HOME/.ssh/dragon_id_ed25519.pub"
[ "$COSMO_RELEASE" != 1 ] || AUTHORIZED_KEYS=""
