# Planet Astro Slide 5G (kernel: astro-linux618). Sourced at the end of
# config.env when DEVICE=astro; overrides the Gemini values there.
DEVICE_LOADED=astro

# Kernel release built by astro-linux618 bin/build-kernel.sh (modules in its
# out/modroot). Must match the kernel in the flashed `boot_a` image.
EXPECT_KVER=6.18.58-astro
ASTRO_KERNEL_DIR=../astro-linux618

GEMINI_HOSTNAME=astro
# USB link to Monolith (g_ether, fixed MACs from the boot cmdline): the
# Astro is 10.15.21.1 as in its rescue initramfs; Monolith is 10.15.21.2
# (NetworkManager "shared" profile on Monolith: NAT + DNS for the Astro).
USB_ADDR=10.15.21.1/24
USB_GW=10.15.21.2

# First image (2026-11-25, user): command line only. There is no Linux
# display driver yet: the console is pushed to the command-mode panel by
# astro-console (from astro-linux618 initramfs/). Plasma comes after
# DSI/panel and GPU.
PACKAGE_LISTS="base.list astro-base.list"
EXTRA_LISTS="astro-cli.list"
DESKTOP_LISTS=""

# Development image: plain login account with the password asked at build
# time, SSH key from the build host (Hydra reaches the Astro through
# Monolith: ssh -J atzero@192.168.0.235 atzero@10.15.21.1).
GEMINI_FIRST_SETUP=0

IMAGE_SIZE=4G
IMAGE_NAME=astro-debian-rootfs.img
IMAGE_LABEL=astro-debian

AUTHORIZED_KEYS="$HOME/.ssh/id_ed25519.pub"
