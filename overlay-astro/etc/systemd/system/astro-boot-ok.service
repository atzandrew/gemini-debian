[Unit]
Description=Confirm a good boot to the Astro initramfs (clears its tripwire)
# Runs once normal start-up has finished; independent of SSH and network.
After=multi-user.target

[Service]
Type=oneshot
TimeoutStartSec=120
ExecStart=/usr/local/sbin/astro-boot-ok

[Install]
WantedBy=multi-user.target
