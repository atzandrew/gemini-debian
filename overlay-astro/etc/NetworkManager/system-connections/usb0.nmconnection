# USB link to the computer on the right-hand port (g_ether gadget, built into
# the Astro kernel). Static: the Astro is @USB_ADDR@, as in its rescue
# initramfs; astro-usb-dhcp.service hands the computer its address. SSH only:
# no gateway, no DNS, no NAT either way (internet is Wi-Fi).
[connection]
id=usb0
type=ethernet
interface-name=usb0
autoconnect=true

[ethernet]

[ipv4]
method=manual
address1=@USB_ADDR@
never-default=true
ignore-auto-dns=true

[ipv6]
method=disabled
