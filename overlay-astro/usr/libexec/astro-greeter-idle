#!/bin/sh
# Astro Slide login screen: panel off after 60 s without input (OLED
# burn-in rule), on again at the next input. Started by SDDM's KWin
# (/etc/sddm.conf.d/astro.conf), which passes WAYLAND_DISPLAY; uses KWin's
# ext-idle-notify-v1 (swayidle) and org_kde_kwin_dpms (kscreen-doctor).
# KWin also wakes the panel on input by itself.
exec swayidle -w \
	timeout 60 'kscreen-doctor --dpms off' \
	resume 'kscreen-doctor --dpms on'
