# Packages added after part 2. Installed on top of base.list, AND shipped
# (with any dependencies the part-2 baseline lacks) as .debs inside
# out/gemini-update.tar.gz, so a running Gemini can take them offline.

# part 4: devmem for the GPU/backlight/A72/WDT scripts
busybox
# part 4: Bluetooth (bluetoothd, bluetoothctl)
bluez
# polkit: lets non-root users manage NetworkManager (nmtui/nmcli) and,
# later, the desktop's power/network controls
polkitd

# ---- login screen (2026-10-16): greetd + tuigreet, a text greeter on tty1
# (etc/greetd/config.toml), replacing SDDM (2026-10-08..16): no compositor
# before login. Plasma (Wayland) starts after login; no X server
# (Xwayland comes with kwin-wayland).
greetd
tuigreet
# KWallet unlocks with the login password (2026-10-19): pam_kwallet5.so,
# added to /etc/pam.d/greetd by bin/apply-files.sh. SDDM's PAM file did
# this before; greetd's doesn't.
libpam-kwallet5
# GL for KWin/Xwayland (replaced by the Gemini Mesa .debs when present)
libgl1-mesa-dri
libegl-mesa0
libglx-mesa0
dbus-user-session

breeze-icon-theme

fonts-dejavu-core
firefox-esr
# brightness from the shell (Plasma uses its own control)
brightnessctl
# battery: UPower (Plasma's battery applet reads it)
upower

# compressed swap in RAM (needs CONFIG_ZRAM, boot image from 2026-10-03)
zram-tools
# ---- sound (2026-10-03): amixer/speaker-test, gpioset (speaker amps), PipeWire
alsa-utils
gpiod
pipewire-audio
rtkit
# ---- tools (2026-10-04, from the hand-tuned device): profiling + GL info
linux-perf
strace
mesa-utils
# ---- everyday apps (beta, 2026-10-08): what a typical Plasma distro ships.
# No Recommends here (this list never pulls them), so the size stays known.
# image viewer (+ HEIF/AVIF/WebP via kimageformat6-plugins, already pulled
# in by Plasma)
gwenview
# archives: Ark + the tools it drives (zip, 7z, rar via unar, xz/bz2/zstd)
ark
zip
unzip
7zip
unar
xz-utils
bzip2
zstd
# text editor (KDE's simple editor; same editing engine as Kate)
kwrite
# document viewer (PDF, EPUB, images) and calculator
okular
kcalc
# video/music player (mpv-based)
haruna
# ---- light software set (2026-10-16): chosen instead of Dolphin, Konsole,
# Gwenview, KWrite and Haruna on the first-boot setup's Software page
# (Calamares packagechooser -> usr/local/sbin/gemini-loadout). Always
# installed, so the choice works offline; "Plasma" keeps them too.
pcmanfm-qt
alacritty
mpv
featherpad
imv
# shell basics
vim-tiny
htop
wget
lsof
# ~/Documents, ~/Downloads, ... on first login
xdg-user-dirs
# crash dumps: coredumpctl + backtraces for KDE's crash reporter (a
# plasmashell crash on the first beta login left nothing to debug, 2026-10-08)
systemd-coredump
# ---- first-boot setup (2026-10-09): Calamares in OEM mode (etc/calamares/:
# welcome, locale, keyboard, users, then removeuser deletes the build-time
# account). Config tested on the device by hand.
calamares
calamares-settings-debian
pkexec
