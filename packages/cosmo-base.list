# Cosmo additions to base.list (headless).
# NetworkManager shared mode on usb0 (DHCP for the host) needs dnsmasq.
dnsmasq-base
# Console keymap from the xkb layout (Fn layer; etc/default/keyboard).
console-setup
# Cover display link (cosmo-codi): Python and gpioset for the STM32 reset.
python3
gpiod
# Audio: UCM profile for the Cosmo card (overlay usr/share/alsa/ucm2/conf.d/cosmo).
alsa-ucm-conf
# Front camera through PipeWire (libcamera plugin; PipeWire from backports).
libspa-0.2-libcamera
