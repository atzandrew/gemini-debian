#!/bin/sh
# gemini-greeter-lid — power off when the lid stays shut with nobody logged in.
#
# At the login screen (greetd/tuigreet) there is no session to keep, and SPM
# suspend is the worse choice there: gemini-suspend-prep refuses it anyway
# (the console keeps the display layer on), and a suspend left running drains
# ~208 mA and can hit the intermittent SPM hang. So logind ignores the lid and
# the silver key (logind.conf.d/gemini.conf) and this watcher powers off once
# the lid has been closed for GRACE seconds with no local user session; opening
# the lid in time cancels it. The backlight is off while it waits.
# Inside Plasma, PowerDevil handles the lid as before. A session that is
# logging out (State=closing) counts as nobody logged in, so a lid closed
# during a slow Shut Down also ends powered off (2026-10-18 overnight drain).
set -u
GRACE=${GRACE:-150}
POLL=5
BL=/sys/class/backlight/backlight/bl_power

log() { echo "$*"; }
lid_closed() {
	[ "$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
		org.freedesktop.login1.Manager LidClosed 2>/dev/null)" = "b true" ]
}
user_logged_in() {	# a local (seat) user session that isn't closing
	for s in $(loginctl list-sessions --no-legend | awk '{print $1}'); do
		[ "$(loginctl show-session "$s" -p Class --value)" = user ] || continue
		[ -n "$(loginctl show-session "$s" -p Seat --value)" ] || continue
		[ "$(loginctl show-session "$s" -p State --value)" = closing ] && continue
		return 0
	done
	return 1
}
uptime_s() { cut -d. -f1 /proc/uptime; }
bl_restore() {
	[ -n "$bl_saved" ] && echo "$bl_saved" > "$BL" 2>/dev/null
	bl_saved=
}

since=
bl_saved=
trap 'bl_restore; exit 0' TERM INT
while :; do
	if lid_closed && ! user_logged_in; then
		if [ -z "$since" ]; then
			since=$(uptime_s)
			bl_saved=$(cat "$BL" 2>/dev/null)
			echo 4 > "$BL" 2>/dev/null
			log "lid closed with nobody logged in: powering off in ${GRACE} s unless it opens"
		elif [ $(( $(uptime_s) - since )) -ge "$GRACE" ]; then
			log "lid still closed after ${GRACE} s at the login screen: powering off"
			systemctl poweroff
			exit 0
		fi
	elif [ -n "$since" ]; then
		bl_restore
		since=
		log "cancelled (lid opened or someone logged in)"
	fi
	sleep "$POLL"
done
