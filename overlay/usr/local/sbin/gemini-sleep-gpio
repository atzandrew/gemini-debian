#!/bin/sh
# gemini-sleep-gpio off|on — speaker amps off for system sleep, put back after.
#
# Measured 2026-10-16 (gemini-nixos notes/connsys-sleep.md E26/E27, awake, SPM-run state):
#   speaker amps, SoC GPIO 243 + 244 (DO 0x10005170 bits 19/20)  ~60 mA
# The amps sit on whenever a session holds the speaker output (gemini-audio), playing or not.
# SPM sleep with the amps off: 263 mA vs 318-333 (E29), clean.
# NOT the USB1 VBUS (GPIO 94) / sw7226-en (72) / fusb301a-sw-en (70) hogs (~11 mA awake): the
# one SPM run with those low too hung (E28), so they stay as they are.
# Writes the pio DO register directly (pinctrl-mt6797: DO = 0x10005100 + 0x10 * (pin / 32)),
# like the E26-E29 tests. "off" saves the amp bits in /run, "on" restores exactly those, so a
# speaker/headphone choice made before sleep comes back unchanged.
# Run by gemini-sleep-gpio.service around sleep.target. NOTE: system suspend itself still
# hangs on this kernel (see bin/apply-files.sh UPower note); this is in place for when it works.
# TODO: amps belong in the kernel as a DAPM simple-audio-amplifier (on only while a stream
# plays, pop-free ordering) — then drop GPIO 243/244 from here and from gemini-audio.
S=/run/gemini-sleep-gpio
G2=0x10005170; M2=$(( (1 << 19) | (1 << 20) ))
rd() { busybox devmem "$1" 32; }
wr() { busybox devmem "$1" 32 "$2"; }
case "$1" in
off)
	b=$(rd $G2)
	echo "$(( b & M2 ))" > "$S"
	wr $G2 $(( b & ~M2 ))
	echo "gemini-sleep-gpio: amps off (saved bits $(( b & M2 )))" ;;
on)
	[ -f "$S" ] || { echo "gemini-sleep-gpio: nothing saved"; exit 0; }
	read s2 < "$S"
	wr $G2 $(( ($(rd $G2) & ~M2) | s2 ))
	rm -f "$S"
	echo "gemini-sleep-gpio: restored" ;;
*)	echo "usage: gemini-sleep-gpio off|on" >&2; exit 2 ;;
esac
