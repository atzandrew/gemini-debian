# Hibernate needs swap + a resume path this device doesn't have.
# (sleep.target / suspend.target: unmasked 2026-10-17, see units.unmask.)
hibernate.target
hybrid-sleep.target
suspend-then-hibernate.target
# smartmontools (pulled in by Plasma's disk monitor): the eMMC has no SMART,
# so smartd fails at every boot ("NO devices found to scan").
smartmontools.service
