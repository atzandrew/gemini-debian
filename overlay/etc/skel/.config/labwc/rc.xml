<?xml version="1.0"?>
<labwc_config>
  <libinput>
    <device category="touch">
      <calibrationMatrix>0 -1 1 1 0 0</calibrationMatrix>
    </device>
  </libinput>
  <keyboard>
    <default/>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl --min-value=10 set 10%-"/></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl set 10%+"/></keybind>
  </keyboard>
</labwc_config>
