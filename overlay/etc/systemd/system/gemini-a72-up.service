# From gemini-nixos services/gemini-pda.nix. OPT-IN, never at boot: bringing
# the A72 cluster up while boot is busy can wedge the device. Start it from a
# settled system: `sudo systemctl start gemini-a72-up` (or cl2-up.sh).
# cl2-down.sh [cpu9|cpu8|both] takes it down again.
[Unit]
Description=Gemini A72 cluster bring-up (cpu8/cpu9 online)
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/modprobe sramldo-smc
ExecStart=/usr/local/sbin/cl2-up.sh
