# Playback route at boot (see /usr/local/bin/gemini-audio). The kernel powers
# the speaker amps itself; switch outputs in the sound settings or with
# gemini-audio speaker|headphone|toggle (as your user).
[Unit]
Description=Gemini audio route
After=sound.target alsa-restore.service systemd-udevd.service
Wants=sound.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gemini-audio route

[Install]
WantedBy=multi-user.target
