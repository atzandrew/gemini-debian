# Speaker amps + USB1 VBUS/switch enables off across system sleep (~71 mA,
# see /usr/local/sbin/gemini-sleep-gpio). Started before sleep.target,
# stopped (= restored) when sleep.target goes away on resume.
[Unit]
Description=Gemini board loads off for sleep (speaker amps, USB1 VBUS)
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gemini-sleep-gpio off
ExecStop=/usr/local/sbin/gemini-sleep-gpio on

[Install]
WantedBy=sleep.target
