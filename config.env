# Settings for the Gemini Debian rootfs build. Sourced by bin/*.sh
# (host side AND inside the build container — keep it plain VAR=value).

# Debian release. trixie = Debian 13 (stable). Its Mesa is 25.0.7, the
# exact base of gemini-nixos patches/mesa-panfrost-geminipda-25.0.7.patch.
DEBIAN_SUITE=trixie

# Kernel the rootfs must match. Must equal the kernel in the boot image
# that is flashed in `boot` (6.6.157 since 2026-10-02). The build refuses
# to continue if gemini-nixos produces a different module version.
EXPECT_KVER=6.6.157

# Login account (member of sudo). The password is asked for at build time
# and only its hash goes into the image.
GEMINI_USER=atzero
GEMINI_HOSTNAME=gemini
GEMINI_TIMEZONE=America/Los_Angeles
GEMINI_LOCALE=en_US.UTF-8

# USB network link to Dragon (g_ether; same addresses as the NixOS build).
USB_ADDR=10.15.19.82/24
USB_GW=10.15.19.1

# Size of the ext4 image that gets flashed. Kept small so the flash is
# quick; the filesystem grows to fill all of userdata on first boot
# (gemini-growfs.service).
IMAGE_SIZE=3G

# ---- host-side only (not used inside the container) -------------------
# Where the gemini-nixos repo lives (source of kernel modules, firmware,
# console keymap). Relative to this repo by default.
GEMINI_NIXOS_DIR=../gemini-nixos
# Public SSH keys allowed to log in as GEMINI_USER (space-separated list
# of .pub files; missing files are skipped with a warning).
AUTHORIZED_KEYS="$HOME/.ssh/id_ed25519.pub"
# The Gemini on the network, for bin/push-bundle.sh (its Wi-Fi address can
# change with DHCP; update as needed). Host-side only.
GEMINI_HOST=atzero@192.168.0.139
