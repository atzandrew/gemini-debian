#!/bin/sh
# Tell the Cosmo initramfs that this root system came up AND is reachable:
# once usb0 has its IPv4 address, overwrite the tripwire flag (8 MiB into
# the raw `cache` partition) with COSMO-OK. If usb0 never comes up, the flag
# stays COSMO-TRY and the next boot goes to the rescue initramfs.
set -e
dev=/dev/disk/by-partlabel/cache
[ -b "$dev" ] || { echo "cosmo-boot-ok: no $dev" >&2; exit 1; }
i=0
until ip -4 addr show dev usb0 2>/dev/null | grep -q 'inet '; do
    i=$((i + 1))
    [ "$i" -le 90 ] || { echo "cosmo-boot-ok: usb0 has no address after 90 s: boot NOT confirmed" >&2; exit 1; }
    sleep 1
done
printf 'COSMO-OK\0' | dd of="$dev" bs=512 seek=16384 count=1 conv=sync,notrunc status=none
sync
echo "cosmo-boot-ok: usb0 up ($(ip -4 -o addr show dev usb0 | awk '{print $4}')), boot confirmed"
