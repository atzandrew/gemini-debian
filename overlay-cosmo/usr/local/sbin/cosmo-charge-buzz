#!/usr/bin/python3
# cosmo-charge-buzz: one short vibration when a charger is plugged in.
# Run by 87-cosmo-charge-buzz.rules on every mt6370-charger change event
# with POWER_SUPPLY_ONLINE as the argument; buzzes only on 0 -> 1. The
# last state lives in /run, so a charger already in at boot does not buzz.
# The vibrator is the "regulator-haptic" input device (MT6358 VIBR LDO,
# force feedback FF_RUMBLE).
#
#   cosmo-charge-buzz 1|0     what the udev rule runs
#   cosmo-charge-buzz --test [ms] [magnitude]  buzz once (to tune the values)
import fcntl
import glob
import os
import struct
import sys
import time

STATE = "/run/cosmo-charge-buzz.state"
LENGTH_MS = 200   # tuned on the device 2026-11-24: 100 ms felt too short;
MAGNITUDE = 0x8000  # 80 ms at 0x6000 did not register

EV_FF = 0x15
FF_RUMBLE = 0x50
# struct ff_effect is 48 bytes on arm64 (the union holds a pointer, so it
# starts at offset 16). EVIOCSFF = _IOW('E', 0x80, struct ff_effect).
EVIOCSFF = (1 << 30) | (48 << 16) | (ord("E") << 8) | 0x80


def haptic_node():
    for name in glob.glob("/sys/class/input/event*/device/name"):
        with open(name) as f:
            if f.read().strip() == "regulator-haptic":
                return "/dev/input/" + name.split("/")[4]
    return None


def buzz(length_ms=LENGTH_MS, magnitude=MAGNITUDE):
    node = haptic_node()
    if not node:
        return
    fd = os.open(node, os.O_RDWR)
    try:
        # type, id (-1 = new), direction, trigger(button, interval),
        # replay(length, delay), pad, rumble(strong, weak), rest of the union
        effect = bytearray(struct.pack("=HhHHHHH2xHH", FF_RUMBLE, -1, 0, 0, 0,
                                       length_ms, 0, magnitude, magnitude))
        effect += bytes(48 - len(effect))
        fcntl.ioctl(fd, EVIOCSFF, effect)
        effect_id = struct.unpack_from("=h", effect, 2)[0]
        # struct input_event: timeval (16 bytes), type, code, value
        os.write(fd, struct.pack("=qqHHi", 0, 0, EV_FF, effect_id, 1))
        time.sleep(length_ms / 1000 + 0.05)
    finally:
        os.close(fd)   # closing the device erases the uploaded effect


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--test":
        buzz(*(int(v, 0) for v in sys.argv[2:4]))
        return
    if arg not in ("0", "1"):
        return
    try:
        with open(STATE) as f:
            last = f.read().strip()
    except OSError:
        last = None
    with open(STATE, "w") as f:
        f.write(arg)
    if last == "0" and arg == "1":
        buzz()


if __name__ == "__main__":
    main()
