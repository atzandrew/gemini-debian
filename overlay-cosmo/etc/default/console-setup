# CONFIGURATION FILE FOR SETUPCON (Cosmo)
# Consult the console-setup(5) manual page.
# Same font as the kernel console (boot cmdline fbcon=font:TER16x32), so
# setupcon does not shrink the text on the 1080x2160 panel.

ACTIVE_CONSOLES="/dev/tty[1-6]"

CHARMAP="UTF-8"

CODESET="Lat15"
FONTFACE="Terminus"
FONTSIZE="16x32"

VIDEOMODE=
